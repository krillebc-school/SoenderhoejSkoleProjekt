@page "/inventory"
@attribute [StreamRendering]

<PageTitle>Inventory</PageTitle>

<h1>Inventory</h1>

<p>Her sætter vi bare lager ind.</p>

<ul>
    <li>
        <label> navn på ting </label> <button @onclick="removeItem">-</button> @antal <button @onclick="addItem">+</button>
    </li>
</ul>
@code
{
    public int antal = 0;
    
    public void removeItem()
    {
        if (antal > 0)
        {
            antal--;
        }
    }
    
    public void addItem()
    {
        if (antal > 0)
        {
            antal++;
        }
    }

}